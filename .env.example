# =============================================================================
# SNAB hireX ATS — Production Environment Variables (Vercel & Local)
# =============================================================================

# --- 1. WHATSAPP NOTIFICATIONS ---
VITE_WHATSAPP_API_URL=https://whatsapp-sending-api.onrender.com

# --- 2. RESUME DOCUMENT STORAGE (Cloudinary - Unsigned Preset) ---
VITE_CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
VITE_CLOUDINARY_UPLOAD_PRESET=resumes

# --- 3. DATABASE & AUTHENTICATION (Firebase Firestore) ---
VITE_FIREBASE_API_KEY=your_firebase_api_key
VITE_FIREBASE_AUTH_DOMAIN=your_project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your_firebase_project_id
VITE_FIREBASE_STORAGE_BUCKET=your_project.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=your_messaging_sender_id
VITE_FIREBASE_APP_ID=your_firebase_app_id
VITE_FIREBASE_MEASUREMENT_ID=your_measurement_id

# --- 4. AI RESUME & JD PARSER (Amazon Bedrock Mantle - Backend / Server-Only) ---
# CRITICAL SECURITY: Never add VITE_ prefix to secret API keys!
# On Vercel, set these in Project Settings -> Environment Variables as standard server env vars.
ANTHROPIC_API_KEY=your_bedrock_mantle_api_key
BEDROCK_CHAT_BASE_URL=https://bedrock-mantle.ap-south-1.api.aws/v1
BEDROCK_MODEL_DEFAULT=zai.glm-4.7-flash

# --- 5. TRANSACTIONAL EMAIL DISPATCH (Amazon SES - Backend / Server-Only) ---
# CRITICAL SECURITY: Never add VITE_ prefix to AWS credentials!
AWS_ACCESS_KEY_ID=your_aws_access_key_id
AWS_SECRET_ACCESS_KEY=your_aws_secret_access_key
AWS_SES_REGION=us-east-1
SES_FROM_EMAIL=info@yourdomain.com
SES_SENDER_NAME="SNAB hireX"

# --- 6. OPTIONAL INBOUND JOB SYNC WEBHOOK (Backend / Server-Only) ---
JOBFETCHED_SECRET_KEY=your_jobfetched_secret_key

# --- 7. ASSEMBLYAI SPEECH TRANSCRIPTION (STT) ---
VITE_ASSEMBLYAI_API_KEY=your_assemblyai_api_key_here
ASSEMBLYAI_API_KEY=your_assemblyai_api_key_here
